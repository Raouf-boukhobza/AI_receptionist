generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model tenants {
  id                       String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_name            String            @db.VarChar(255)
  email                    String            @unique @db.VarChar(255)
  password_hash            String            @db.VarChar(255)
  waba_id                  String?           @unique @db.VarChar(255)
  phone_number_id          String?           @unique @db.VarChar(255)
  access_token             String?           @db.VarChar(255)
  status                   tenant_status     @default(incomplete)
  whatsapp_connected_at    DateTime?         @db.Timestamp(6)
  knowledge_base_passed_at DateTime?         @db.Timestamp(6)
  created_at               DateTime          @default(now()) @db.Timestamp(6)
  updated_at               DateTime          @default(now()) @db.Timestamp(6)
  address                  String?
  business_phone           String            @db.VarChar(255)
  name                     String            @db.VarChar(255)
  personal_phone           String            @db.VarChar(255)
  refresh_token            String?           @db.VarChar(255)
  bookings                 bookings[]
  conversations            conversations[]
  doctor_hours             doctor_hours[]
  doctor_services          doctor_services[]
  doctors                  doctors[]
  faqs                     faqs[]
  knowledge_base           knowledge_base[]
  messages                 messages[]
  notifications            notifications[]
  services                 services[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model services {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String            @db.Uuid
  name             String
  price            Decimal           @db.Decimal(10, 2)
  duration_minutes Int
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime          @default(now()) @db.Timestamptz(6)
  bookings         bookings[]
  doctor_services  doctor_services[]
  tenants          tenants           @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id], map: "idx_services_tenants")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model doctors {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String            @db.Uuid
  name            String
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  bookings        bookings[]
  doctor_hours    doctor_hours[]
  doctor_services doctor_services[]
  tenants         tenants           @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id], map: "idx_doctors_tenants")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model doctor_services {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  doctor_id  String   @db.Uuid
  service_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  doctors    doctors  @relation(fields: [doctor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  services   services @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenants    tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([doctor_id, service_id])
  @@index([doctor_id], map: "idx_doctor_services_doctor")
  @@index([service_id], map: "idx_doctor_services_service")
  @@index([tenant_id], map: "idx_doctor_services_tenants")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model conversations {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String              @db.Uuid
  client_phone String
  status       conversation_status @default(ai_active)
  version      Int                 @default(1)
  created_at   DateTime            @default(now()) @db.Timestamptz(6)
  updated_at   DateTime            @default(now()) @db.Timestamptz(6)
  tenants      tenants             @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages     messages[]

  @@index([client_phone], map: "idx_conversations_phone")
  @@index([tenant_id], map: "idx_conversations_tenants")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model messages {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String          @db.Uuid
  conversation_id     String          @db.Uuid
  sender              message_sender
  content             String
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  status              message_status? @default(received)
  wa_message_id       String?         @db.VarChar(128)
  reply_to_message_id String?         @unique(map: "uq_messages_reply_to", where: raw("(reply_to_message_id IS NOT NULL)")) @db.Uuid
  dispatch_attempts   Int             @default(0)
  last_error          String?
  dispatched_at       DateTime?       @db.Timestamptz(6)
  delivered_at        DateTime?       @db.Timestamptz(6)
  conversations       conversations   @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages            messages?       @relation("messagesTomessages", fields: [reply_to_message_id], references: [id], onUpdate: NoAction)
  other_messages      messages?       @relation("messagesTomessages")
  tenants             tenants         @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, wa_message_id], map: "uq_messages_tenant_wamid", where: raw("(wa_message_id IS NOT NULL)"))
  @@index([conversation_id], map: "idx_messages_conversation")
  @@index([tenant_id], map: "idx_messages_tenants")
  @@index([created_at], map: "idx_messages_outbox", where: raw("(status = ANY (ARRAY['pending_dispatch'::message_status, 'dispatch_failed'::message_status]))"))
}

/// This table contains exclusion constraints and requires additional setup for migrations. Visit https://pris.ly/d/exclusion-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model bookings {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String         @db.Uuid
  doctor_id           String         @db.Uuid
  service_id          String         @db.Uuid
  client_phone        String
  start_time          DateTime       @db.Timestamptz(6)
  end_time            DateTime       @db.Timestamptz(6)
  status              booking_status @default(confirmed)
  reminder_24h_job_id String?
  reminder_1h_job_id  String?
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime       @default(now()) @db.Timestamptz(6)
  doctors             doctors        @relation(fields: [doctor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  services            services       @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenants             tenants        @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([doctor_id], map: "idx_bookings_doctor")
  @@index([start_time], map: "idx_bookings_start_time")
  @@index([tenant_id], map: "idx_bookings_tenants")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model notifications {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String            @db.Uuid
  type       notification_type
  link       String?
  read_at    DateTime?         @db.Timestamptz(6)
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  tenants    tenants           @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id], map: "idx_notifications_tenants")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model knowledge_base {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String                @db.Uuid
  content    String
  embedding  Unsupported("vector")
  metadata   Json                  @default("{}")
  created_at DateTime              @default(now()) @db.Timestamptz(6)
  updated_at DateTime              @default(now()) @db.Timestamptz(6)
  tenants    tenants               @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id], map: "idx_knowledge_base_tenants")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model doctor_hours {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String      @db.Uuid
  doctor_id  String      @db.Uuid
  day        day_of_week
  start_time String      @db.VarChar(5)
  end_time   String      @db.VarChar(5)
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  updated_at DateTime    @default(now()) @db.Timestamptz(6)
  doctors    doctors     @relation(fields: [doctor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenants    tenants     @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([doctor_id, day])
  @@index([doctor_id], map: "idx_doctor_hours_doctor")
  @@index([tenant_id], map: "idx_doctor_hours_tenants")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model faqs {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  question   String
  answer     String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  tenants    tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum tenant_status {
  active
  incomplete
  expired
}

enum conversation_status {
  ai_active
  needs_human
  human_active
}

enum message_sender {
  client
  ai
  owner
}

enum booking_status {
  confirmed
  cancelled
  completed
}

enum notification_type {
  ai_escalation
  booking_created
  subscription_expiring
  payment_failed
}

enum day_of_week {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum message_status {
  received
  processing
  replied
  escalated
  pending_dispatch
  sending
  sent
  dispatch_failed
  delivered
  read
  undeliverable
  dead
}
