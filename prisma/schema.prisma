generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model tenants {
  id                       String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_name            String        @db.VarChar(255)
  email                    String        @unique @db.VarChar(255)
  password_hash            String        @db.VarChar(255)
  waba_id                  String?       @unique @db.VarChar(255)
  phone_number_id          String?       @unique @db.VarChar(255)
  access_token             String?       @db.VarChar(255)
  status                   tenant_status @default(incomplete)
  whatsapp_connected_at    DateTime?     @db.Timestamp(6)
  knowledge_base_passed_at DateTime?     @db.Timestamp(6)
  created_at               DateTime      @default(now()) @db.Timestamp(6)
  updated_at               DateTime      @default(now()) @db.Timestamp(6)
  doctors                  doctors[]
  services                 services[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model services {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String   @db.Uuid
  name             String
  price            Decimal  @db.Decimal(10, 2)
  duration_minutes Int
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
  tenants          tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id], map: "idx_services_tenants")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model doctors {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  name       String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  tenants    tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id], map: "idx_doctors_tenants")
}

enum tenant_status {
  active
  incomplete
  expired
}
