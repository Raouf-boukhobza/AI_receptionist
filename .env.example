# Copy to .env and fill in real values. Never commit .env.
# See docker-compose.yml for how compose-only vars are used.

# ---- App ----
NODE_ENV=development
PORT=3000

# ---- PostgreSQL (app connection) ----
DATABASE_URL=postgresql://raouf:password@localhost:5432/ai_receptionist
# Used by the app container to reach postgres over the compose network
MIGRATE_DATABASE_URL=postgresql://raouf:password@postgres:5432/ai_receptionist

# ---- PostgreSQL (compose init, postgres service) ----
POSTGRES_USER=raouf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_receptionist
APP_USER_PASSWORD=change-me

# ---- Auth (MUST be long random strings in real envs, boot fails on placeholders) ----
JWT_SECRET=change-me-generate-a-long-random-string
JWT_REFRESH_SECRET=change-me-generate-another-long-random-string

# ---- AI ----
GEMINI_API_KEY=your-gemini-api-key

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for local dev without a password
REDIS_PASSWORD=

# ---- WhatsApp Cloud API ----
META_GRAPH_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# ---- NestJS Observe (optional; SDK stays off when empty) ----
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# ---- Frontend CORS (comma-separated, production only) ----
FRONTEND_URLS=http://localhost:5173

# ---- Dev tunnel (only needed with --profile ngrok) ----
NGROK_AUTHTOKEN=your-ngrok-authtoken
